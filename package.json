{
  "name": "spdl-renderers",
  "version": "1.0.0",
  "private": true,
  "description": "Renderers for the Spreadsheet Page Description Language (SPDL)",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "golden:update": "node scripts/update-golden.js",
    "lint:examples": "node spdl-lint.js examples/*.spdl"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
    "lint": "eslint . spdlrender.gs",
    "lint:examples": "node spdl-lint.js --max-warnings 0 examples/*.spdl",
    "golden:update": "node scripts/update-golden.js",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0"
  }
}
