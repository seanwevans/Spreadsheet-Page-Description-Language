{
  "name": "spdl-parser",
  "version": "1.0.0",
  "description": "Reference parser, linter, SVG exporter and CLI for the Spreadsheet Page Description Language (SPDL)",
  "license": "MIT",
  "keywords": [
    "spdl",
    "spreadsheet",
    "page-description-language",
    "google-sheets",
    "excel",
    "airtable",
    "svg",
    "parser"
  ],
  "homepage": "https://github.com/seanwevans/Spreadsheet-Page-Description-Language#readme",
  "bugs": "https://github.com/seanwevans/Spreadsheet-Page-Description-Language/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanwevans/Spreadsheet-Page-Description-Language.git"
  },
  "main": "spdl-parser.js",
  "bin": {
    "spdl": "bin/spdl.js",
    "md2spdl": "tools/md2spdl.js"
  },
  "files": [
    "bin/",
    "tools/",
    "spdl-parser.js",
    "spdl-lint.js",
    "spdl-svg.js",
    "spdlrender.gs",
    "spdlrender.office.ts",
    "spdlrender.vba",
    "spdlrender.numbers.applescript",
    "spdlrender.airtable.js",
    "spdlrender.airtable.config.json",
    "SPEC.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "golden:update": "node scripts/update-golden.js",
    "lint:examples": "node spdl-lint.js examples/*.spdl",
    "render:examples": "node scripts/render-examples.js"
    "lint:examples": "node spdl-lint.js examples/*.spdl"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
    "lint": "eslint . spdlrender.gs",
    "lint:examples": "node spdl-lint.js --max-warnings 0 examples/*.spdl",
    "golden:update": "node scripts/update-golden.js",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0"
  }
}
